function showM(i){var el=$("m"+i),x=cur[i];if(!el)return Promise.resolve();el.innerHTML='<p class="hint">Finding the meaning… · Anlam aranıyor…</p>';return getM(x.d).then(function(r){if(x.free)x.t=r.tr||"";el.innerHTML='<div class="info"><div><small>Meaning · Anlamı</small><span>'+pretty(r.meaning||"")+'</span></div><div><small>Example · Örnek</small><span>'+pretty(r.example||"")+'</span><i>'+pretty(r.exampleTr||"")+'</i></div>'+(x.free?'<div><small>Turkish · Türkçesi</small><span>'+pretty(r.tr||"")+'</span></div>':"")+'</div>'}).catch(function(){el.innerHTML='<p class="hint">Meaning is not available right now · Anlam şu an yok</p>'})}
$("go").addEventListener("click",function(){if($("q").value.trim()){save($("q").value);showM(0)}});
$("q").addEventListener("keydown",function(e){if(e.key==="Enter"&&$("q").value.trim()){save($("q").value);showM(0)}});
var FB={apiKey:"AIzaSyAA-411OLuBGvNuYG9L_BLHY3DOe17oUSo",authDomain:"abibat-5ab02.firebaseapp.com",projectId:"abibat-5ab02",appId:"1:386908265293:web:7ea326603b3d1c7c6bf504"};
var fbOK=FB.apiKey&&window.firebase,user=null,hist=[],auth,store;
function uiAuth(){$("who").textContent=user?"Hi, "+(user.displayName||user.email):"";$("login").innerHTML=user?"Sign out<small>Çıkış</small>":"Sign in with Google<small>Google ile giriş</small>"}
function histShow(){var h=$("hist");if(!user){h.innerHTML=fbOK?"<b>Sign in to save your searches · Aramalarını kaydetmek için giriş yap</b>":"";return}h.innerHTML=hist.length?"<b>Recent searches · Son aramalar</b>"+hist.map(function(w,i){return '<button data-w="'+i+'">'+esc(w)+"</button>"}).join(""):"<b>No searches yet · Henüz arama yok</b>"}
function save(q){if(!user)return;q=q.trim().slice(0,80);hist=[q].concat(hist.filter(function(w){return w.toLowerCase()!==q.toLowerCase()})).slice(0,20);histShow();store.collection("users").doc(user.uid).set({searches:hist}).catch(function(){})}
$("hist").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;$("q").value=hist[+b.dataset.w];show();showM(0)});
if(fbOK){firebase.initializeApp(FB);auth=firebase.auth();store=firebase.firestore();
$("login").onclick=function(){if(user)auth.signOut();else auth.signInWithPopup(new firebase.auth.GoogleAuthProvider()).catch(function(){})};
auth.onAuthStateChanged(function(u){user=u;uiAuth();hist=[];histShow();if(u)store.collection("users").doc(u.uid).get().then(function(d){hist=d.exists&&d.data().searches||[];histShow()}).catch(function(){})})}
else $("login").style.display="none";
uiAuth();histShow();
show();
</script>
